# Copier vers .env sur le VPS : cp .env.example .env

NODE_ENV=production
PORT=3000
HOST_PORT=3000

# PostgreSQL (ex. Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Secrets (générer des valeurs longues et aléatoires)
JWT_SECRET=remplacer-par-une-chaine-secrete-longue
SESSION_SECRET=remplacer-par-une-autre-chaine-secrete

# Premier administrateur, créé au démarrage s'il n'existe aucun admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=remplacer-par-un-mot-de-passe

# Email (SMTP) — ne jamais mettre ces valeurs dans le code
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=noreply
SMTP_PASS=remplacer-par-le-mot-de-passe-smtp
MAIL_FROM_EMAIL=noreply@plateform-test.cm
MAIL_FROM_NAME=Platform Web Test
# true seulement si le serveur mail utilise un certificat auto-signé
SMTP_ALLOW_SELF_SIGNED=false

# Firebase FCM — JSON service account sur une ligne (jq -c . fichier.json)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"votre-projet",...}

# Alternative : chemin vers un fichier JSON (prioritaire si défini)
# FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-adminsdk.json
